# Hype — ignore secrets, local data, and build artifacts.
# NOTE: secrets must NEVER be committed. They live in the macOS Keychain,
# never in files. This .gitignore is a second line of defense.

.venv/
__pycache__/
*.pyc
*.pyo

# Local runtime data (DB, logs). Portable: regenerated on first run.
# Anchored to the project root so it does NOT match the hype/data/ source pkg.
/data/
*.db
*.db-journal
*.log

# Config may contain owner-set values (e.g. home wallet). Keep it local.
# (No secrets/keys are ever written here — those go to Keychain.)
config.toml

# Never commit ad-hoc secret-handoff files (keys belong in the Keychain only).
Hello.txt
*secret*
*apikey*
*api_key*
*.key

# OS / editor
.DS_Store
.idea/
.vscode/

# PyInstaller
build/
dist/
dist*/
*.app/
*.spec

# Activity-log exports (contain trade history)
*.csv

# Icon build intermediates (regenerated by tools/generate_icon.py)
hype/ui/assets/Hype.iconset/
!Hype.spec
